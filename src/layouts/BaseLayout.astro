---
import "../../styles.css";
import { absoluteUrl, isDomainConfigured, site, withBase } from "../data/site";
import { translations } from "../data/i18n";

interface Props {
  title?: string;
  description?: string;
  path?: string;
  image?: string;
}

const {
  title = `${site.name} | Fragrance, held in nature`,
  description = site.description,
  path = "/",
  image = "/og/home-og.jpg"
} = Astro.props;
const canonical = absoluteUrl(path);
const socialImage = absoluteUrl(image);
const i18nJson = JSON.stringify(translations).replace(/</g, "\\u003c");
---

<!doctype html>
<html lang="en-PK">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="robots" content={isDomainConfigured ? "index, follow" : "noindex, nofollow"} />
    {isDomainConfigured && <link rel="canonical" href={canonical} />}
    <title>{title}</title>
    <link rel="icon" type="image/png" href={withBase("/brand/Log.png")} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600&family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600&family=Great+Vibes&family=Lora:wght@400;500&display=swap" rel="stylesheet" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:alt" content={`${site.name} — ${description}`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={`${site.name} — ${description}`} />
    <meta name="theme-color" content="#f8f3ec" />
    {isDomainConfigured && <link rel="sitemap" href={absoluteUrl("/sitemap-index.xml")} />}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
    <script type="application/json" id="hn-i18n-data" is:inline set:html={i18nJson}></script>
    <script is:inline>
      (() => {
        const dataNode = document.querySelector("#hn-i18n-data");
        const dictionaries = dataNode ? JSON.parse(dataNode.textContent || "{}") : {};
        const localeOptions = {
          en: { lang: "en-PK", dir: "ltr" },
          ur: { lang: "ur", dir: "rtl" },
          ps: { lang: "ps", dir: "rtl" },
          pa: { lang: "pa", dir: "rtl" },
          sd: { lang: "sd", dir: "rtl" }
        };
        const english = dictionaries.en || {};
        const getDictionary = (locale) => ({ ...english, ...(dictionaries[locale] || {}) });
        const get = (key, fallback = key) => {
          const locale = document.documentElement.dataset.locale || "en";
          return getDictionary(locale)[key] || fallback;
        };
        const applyLocale = (locale, persist = true) => {
          const safeLocale = localeOptions[locale] ? locale : "en";
          const dictionary = getDictionary(safeLocale);
          document.documentElement.dataset.locale = safeLocale;
          document.documentElement.lang = localeOptions[safeLocale].lang;
          document.documentElement.dir = localeOptions[safeLocale].dir;
          document.querySelectorAll("[data-i18n]").forEach((element) => {
            const key = element.getAttribute("data-i18n");
            if (key && dictionary[key]) element.textContent = dictionary[key];
          });
          document.querySelectorAll("[data-i18n-placeholder]").forEach((element) => {
            const key = element.getAttribute("data-i18n-placeholder");
            if (key && dictionary[key]) element.setAttribute("placeholder", dictionary[key]);
          });
          document.querySelectorAll("[data-i18n-aria-label]").forEach((element) => {
            const key = element.getAttribute("data-i18n-aria-label");
            if (key && dictionary[key]) element.setAttribute("aria-label", dictionary[key]);
          });
          document.querySelectorAll("[data-language-select]").forEach((select) => {
            select.value = safeLocale;
          });
          window.hnI18n = { get, locale: safeLocale, dictionary };
          window.dispatchEvent(new CustomEvent("hn:localechange", { detail: { locale: safeLocale, dictionary } }));
          if (persist) {
            try { localStorage.setItem("heaven-and-nature-locale", safeLocale); } catch {}
          }
        };
        window.hnI18n = { get, locale: "en", dictionary: english };
        document.querySelectorAll("[data-language-select]").forEach((select) => {
          select.addEventListener("change", (event) => applyLocale(event.target.value));
        });
        let savedLocale = "en";
        try { savedLocale = localStorage.getItem("heaven-and-nature-locale") || "en"; } catch {}
        applyLocale(savedLocale, false);
      })();
    </script>
  </body>
</html>
