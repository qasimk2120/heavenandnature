---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import { withBase } from "../../data/site";
---

<BaseLayout title="Terms | Heaven & Nature" description="Terms for using the Heaven and Nature website." path="/terms/">
  <SiteHeader />
  <main id="main" class="legal-page">
    <a class="product-back text-link" href={withBase("/")}><span data-i18n="legal.back">Back to Heaven &amp; Nature</span></a>
    <h1 data-i18n="terms.eyebrow">Terms</h1>
    <p data-i18n="terms.intro">This website presents Heaven &amp; Nature fragrance photography and release information. It is not an online checkout. Shop links open WhatsApp so you can ask the brand about a bottle, confirm availability and arrange an order directly.</p>
    <h2 data-i18n="terms.productTitle">Product information</h2>
    <p data-i18n="terms.productBody">Names, images, sizes, availability and fragrance notes are added only after the brand confirms them. Photography may show H&amp;N Scents packaging while the public brand identity is being finalised.</p>
    <h2 data-i18n="terms.contentTitle">Images and content</h2>
    <p data-i18n="terms.contentBody">Website text and layout are provided for Heaven &amp; Nature. Product photography is supplied by the brand and may not be copied or reused without permission.</p>
    <h2 data-i18n="terms.updatesTitle">Updates</h2>
    <p data-i18n="terms.updatesBody">Ordering details, pricing and delivery terms are confirmed directly with the brand through its official WhatsApp channel.</p>
  </main>
  <SiteFooter />
</BaseLayout>
