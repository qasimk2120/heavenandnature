---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { withBase } from "../../data/site";
---

<BaseLayout title="Terms | Heaven & Nature" description="Terms for using the Heaven and Nature website." path="/terms/">
  <main id="main" class="legal-page">
    <a class="product-back text-link" href={withBase("/")}>Back to Heaven &amp; Nature</a>
    <p class="eyebrow">Terms</p>
    <h1>A clear first look.</h1>
    <p>This website presents Heaven &amp; Nature fragrance photography and release information. It is not currently an online checkout or a promise that a listed product is available to order.</p>
    <h2>Product information</h2>
    <p>Names, images, sizes, availability and fragrance notes are added only after the brand confirms them. Photography may show H&amp;N Scents packaging while the public brand identity is being finalised.</p>
    <h2>Images and content</h2>
    <p>Website text and layout are provided for Heaven &amp; Nature. Product photography is supplied by the brand and may not be copied or reused without permission.</p>
    <h2>Updates</h2>
    <p>These terms will be updated before any ordering flow or customer account system is introduced.</p>
  </main>
</BaseLayout>
