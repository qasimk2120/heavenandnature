---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { withBase } from "../data/site";
---

<BaseLayout title="Page not found | Heaven & Nature" description="The requested Heaven and Nature page could not be found.">
  <SiteHeader />
  <main id="main" class="not-found">
    <p class="eyebrow" data-i18n="notFound.eyebrow">404</p>
    <h1 data-i18n="notFound.title">This page has moved on.</h1>
    <a class="text-link" href={withBase("/")}><span data-i18n="notFound.return">Return to Heaven &amp; Nature</span> <span aria-hidden="true">→</span></a>
  </main>
</BaseLayout>
