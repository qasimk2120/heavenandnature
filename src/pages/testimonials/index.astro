---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import StructuredData from "../../components/StructuredData.astro";
import { absoluteUrl, whatsappUrl, withBase } from "../../data/site";

const pageSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "Customer notes | H&N Scents",
  description: "Approved customer notes from WhatsApp and Instagram for H&N Scents.",
  url: absoluteUrl("/testimonials/"),
  isPartOf: { "@type": "WebSite", name: "Heaven & Nature", url: absoluteUrl("/") }
};
---

<BaseLayout
  title="Customer notes | H&N Scents"
  description="Approved customer notes from WhatsApp and Instagram for H&N Scents."
  path="/testimonials/"
>
  <StructuredData data={pageSchema} />

  <SiteHeader />

  <main id="main" class="notes-page">
    <div class="notes-heading">
      <p class="eyebrow" data-i18n="notes.eyebrow">From the people who wear it</p>
      <h1 data-i18n="notes.title">Customer notes</h1>
      <p data-i18n="notes.intro">We’re gathering the first approved WhatsApp and Instagram notes here. Each one will be shown with its source and the scent it refers to, once confirmed.</p>
    </div>

    <div class="notes-ledger" aria-label="Customer review sources">
      <section class="notes-source" aria-labelledby="whatsapp-notes-title">
        <p class="notes-source-label" data-i18n="notes.whatsappLabel">01 · WhatsApp</p>
        <h2 id="whatsapp-notes-title" data-i18n="notes.whatsappTitle">The messages people send us</h2>
        <p data-i18n="notes.whatsappBody">Approved screenshots or wording will be framed here with the product name and date, keeping the customer’s voice intact.</p>
        <p class="notes-pending" data-i18n="notes.pending">Reviews will appear here after the original message or approved wording is supplied.</p>
      </section>

      <section class="notes-source" aria-labelledby="instagram-notes-title">
        <p class="notes-source-label" data-i18n="notes.instagramLabel">02 · Instagram</p>
        <h2 id="instagram-notes-title" data-i18n="notes.instagramTitle">Notes from the feed</h2>
        <p data-i18n="notes.instagramBody">Instagram mentions and story replies will be credited to the handle only when permission and the final wording are confirmed.</p>
        <p class="notes-pending" data-i18n="notes.pending">Reviews will appear here after the original post, story or approved wording is supplied.</p>
      </section>
    </div>

    <div class="notes-actions">
      <p class="eyebrow" data-i18n="notes.actionEyebrow">Have a note to share?</p>
      <p data-i18n="notes.actionBody">Send the original WhatsApp message or Instagram screenshot. We’ll confirm how you’d like it credited before it goes live.</p>
      <a class="text-link" href={whatsappUrl("Hi H&N Scents, I would like to share a customer review.")} target="_blank" rel="noreferrer"><span data-i18n="notes.share">Share a review</span> <span aria-hidden="true">↗</span></a>
    </div>
  </main>

  <footer>
    <a class="brand-lockup" href={withBase("/")}>
      <img src={withBase("/brand/Logo.jpeg")} alt="" width="38" height="38" />
      <span class="wordmark">Heaven <i>&amp;</i> Nature</span>
    </a>
    <p data-i18n="footer.tagline">Fragrance, held in nature.</p>
    <nav aria-label="Footer links"><a href={withBase("/contact/")}><span data-i18n="footer.contact">Contact</span></a><a href={withBase("/testimonials/")}><span data-i18n="footer.notes">Customer notes</span></a><a href={whatsappUrl("Hi H&N Scents, I would like to ask about the collection.")} target="_blank" rel="noreferrer"><span data-i18n="footer.shop">Shop on WhatsApp</span></a><a href={withBase("/privacy/")}><span data-i18n="footer.privacy">Privacy</span></a><a href={withBase("/terms/")}><span data-i18n="footer.terms">Terms</span></a></nav>
    <p>© {new Date().getFullYear()} Heaven &amp; Nature</p>
  </footer>
</BaseLayout>
