---
import BaseLayout from "../layouts/BaseLayout.astro";
import BatchCard from "../components/BatchCard.astro";
import SiteHeader from "../components/SiteHeader.astro";
import StructuredData from "../components/StructuredData.astro";
import { batches } from "../data/batches";
import { absoluteUrl, configuredSiteUrl, site, whatsappBaseUrl, whatsappUrl, withBase } from "../data/site";

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: site.name,
  description: site.description,
  "@id": configuredSiteUrl ? absoluteUrl("/#organization") : undefined,
  logo: configuredSiteUrl ? absoluteUrl("/brand/Logo.jpeg") : undefined,
  url: configuredSiteUrl ? absoluteUrl("/") : undefined,
  areaServed: {
    "@type": "Country",
    name: site.location
  }
};

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: site.name,
  description: site.description,
  url: configuredSiteUrl ? absoluteUrl("/") : undefined,
  inLanguage: "en-PK",
  publisher: { "@id": configuredSiteUrl ? absoluteUrl("/#organization") : undefined }
};

const catalogueSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "H&N Scents bottle catalogue",
  description: "Owner-supplied visual references for H&N Scents fragrance bottles.",
  numberOfItems: batches.length,
  itemListElement: batches.map((batch, index) => ({
    "@type": "ListItem",
    position: index + 1,
    name: batch.name,
    description: batch.shortDescription,
    image: batch.image && configuredSiteUrl ? absoluteUrl(batch.image) : undefined
  }))
};

const catalogueJson = JSON.stringify(batches).replace(/</g, "\\u003c");
---

<BaseLayout
  title="H&N Scents | Heaven & Nature perfume in Pakistan"
  description="Explore H&N Scents fragrance bottles, presentation boxes and current catalogue references. Ask about availability and delivery throughout Pakistan on WhatsApp."
  path="/"
  image="/og/home-og.jpg"
>
  <StructuredData data={[organizationSchema, websiteSchema, catalogueSchema]} />
  <SiteHeader showCart />

  <main id="main">
    <section class="hero" id="top" aria-labelledby="hero-title">
      <figure class="hero-still-life">
        <img src={withBase("/batches/collection-flat-lay.jpg")} alt="A selection of H&N Scents perfume bottles arranged around a presentation box." width="1200" height="1500" fetchpriority="high" decoding="async" />
      </figure>
      <div class="hero-copy">
        <p class="eyebrow" data-i18n="home.eyebrow">Heaven &amp; Nature · Pakistan</p>
        <h1 id="hero-title">H&amp;N Scents</h1>
        <p class="hero-intro" data-i18n="home.intro">A photographic catalogue of the bottles, labels and presentation pieces currently shared by the brand.</p>
        <div class="hero-actions">
          <a class="text-link" href="#collection"><span data-i18n="home.see">See the bottles</span></a>
          <a class="text-link" href={whatsappUrl("Hi H&N Scents, I would like to ask about the collection.")} target="_blank" rel="noreferrer"><span data-i18n="home.shop">Shop on WhatsApp</span></a>
        </div>
        <p class="delivery-note">
          <span data-i18n="home.deliveryLabel">Nationwide delivery</span>
          <strong data-i18n="home.deliveryTitle">Throughout Pakistan</strong>
          <small data-i18n="home.deliveryNote">Ask on WhatsApp for the current batch and delivery details.</small>
        </p>
      </div>
    </section>

    <section class="collection" id="collection" aria-labelledby="collection-title">
      <div class="section-heading">
        <p class="eyebrow" data-i18n="home.catalogueEyebrow">Bottle catalogue</p>
        <h2 id="collection-title" data-i18n="home.collectionTitle">Six bottle references</h2>
        <p data-i18n="home.collectionIntro">These six bottles are shown as a visual reference from the supplied H&amp;N Scents photography. Choose a bottle to ask about availability and ordering on WhatsApp.</p>
      </div>
      <p class="collection-delivery"><span data-i18n="home.collectionDeliveryLabel">Wherever you are</span> <span data-i18n="home.collectionDelivery">H&amp;N Scents delivers throughout Pakistan.</span></p>
      <div class="catalogue-filters" aria-label="Browse by scent style">
        <p class="eyebrow" data-i18n="home.categoryEyebrow">Browse by scent style</p>
        <div class="category-filter-list" role="group" aria-label="Scent style filters">
          <button class="category-filter is-active" type="button" data-category-filter="all" aria-pressed="true" data-i18n="home.categoryAll">All scents</button>
          <button class="category-filter" type="button" data-category-filter="fresh" aria-pressed="false" data-i18n="home.categoryFresh">Fresh</button>
          <button class="category-filter" type="button" data-category-filter="floral" aria-pressed="false" data-i18n="home.categoryFloral">Floral</button>
          <button class="category-filter" type="button" data-category-filter="woody" aria-pressed="false" data-i18n="home.categoryWoody">Woody</button>
          <button class="category-filter" type="button" data-category-filter="oud" aria-pressed="false" data-i18n="home.categoryOud">Oud</button>
        </div>
        <p class="category-filter-status" data-category-filter-status aria-live="polite" data-i18n="home.categoryStatusAll">Showing all six references.</p>
      </div>
      {batches.length ? (
        <ul class="catalogue-grid">
          {batches.map((batch) => <BatchCard batch={batch} />)}
        </ul>
      ) : (
        <p class="empty-state">The first release will be announced here.</p>
      )}
    </section>

    <section class="ordering-guide" aria-labelledby="ordering-title">
      <div class="ordering-heading">
        <p class="eyebrow" data-i18n="home.orderEyebrow">How ordering works</p>
        <h2 id="ordering-title" data-i18n="home.orderTitle">A simple conversation, not a checkout maze</h2>
        <p data-i18n="home.orderIntro">Choose a bottle here, then send your selection to the brand on WhatsApp. Availability, price and delivery are confirmed with you directly.</p>
      </div>
      <ol class="ordering-steps">
        <li class="ordering-step">
          <span class="ordering-step-icon" aria-hidden="true"><svg viewBox="0 0 24 24" role="presentation"><circle cx="11" cy="11" r="6.5"></circle><path d="m16 16 4 4"></path></svg></span>
          <span class="ordering-step-number">01</span>
          <h3 data-i18n="home.orderStepOne">Choose a bottle</h3>
          <p data-i18n="home.orderStepOneBody">Open the details to see its notes and composition.</p>
        </li>
        <li class="ordering-step">
          <span class="ordering-step-icon" aria-hidden="true"><svg viewBox="0 0 24 24" role="presentation"><path d="M5 7.5h14v11H5z"></path><path d="M8 7.5a4 4 0 0 1 8 0"></path><path d="M9 12h6"></path></svg></span>
          <span class="ordering-step-number">02</span>
          <h3 data-i18n="home.orderStepTwo">Build your selection</h3>
          <p data-i18n="home.orderStepTwoBody">Add one or more bottles to the cart while you browse.</p>
        </li>
        <li class="ordering-step">
          <span class="ordering-step-icon" aria-hidden="true"><svg viewBox="0 0 24 24" role="presentation"><path d="M4 5h16v12H4z"></path><path d="m8 21 4-4 4 4"></path><path d="M8 9h8M8 12h5"></path></svg></span>
          <span class="ordering-step-number">03</span>
          <h3 data-i18n="home.orderStepThree">Send it on WhatsApp</h3>
          <p data-i18n="home.orderStepThreeBody">We’ll confirm the current batch, cost and delivery with you.</p>
        </li>
      </ol>
      <a class="ordering-cta text-link" href={whatsappUrl("Hi H&N Scents, I would like to ask about the collection.")} target="_blank" rel="noreferrer"><span data-i18n="home.orderCta">Start on WhatsApp</span><span class="link-icon" aria-hidden="true">↗</span></a>
    </section>

    <section class="craft" id="story" aria-labelledby="craft-title">
      <figure class="craft-art">
        <img src={withBase("/batches/presentation-box.jpg")} alt="An open H&N Scents presentation box beside its closed floral box." width="1200" height="1200" loading="lazy" decoding="async" />
      </figure>
      <div class="craft-copy">
        <p class="eyebrow" data-i18n="home.packagingEyebrow">Packaging details</p>
        <h2 id="craft-title" data-i18n="home.packagingTitle">The bottle, clearly</h2>
        <p data-i18n="home.packagingText">Clear glass keeps the liquid visible. The wooden cap adds warmth. The printed label gives each bottle its own character.</p>
        <p class="quiet" data-i18n="home.packagingQuiet">There is no online checkout here. Use WhatsApp to ask about a bottle, confirm the current batch and arrange an order with the brand.</p>
      </div>
    </section>
  </main>

  <dialog class="product-dialog" data-product-dialog aria-labelledby="product-dialog-title">
    <div class="product-dialog-inner">
      <button class="dialog-close" type="button" data-dialog-close aria-label="Close product details" data-i18n-aria-label="home.dialogClose"><span data-i18n="home.dialogClose">Close</span></button>
      <div class="product-dialog-grid">
        <figure class="product-dialog-image"><img data-dialog-image src="" alt="" /></figure>
        <div class="product-dialog-copy">
          <p class="eyebrow" data-i18n="home.detailsEyebrow">Bottle details</p>
          <h2 id="product-dialog-title" data-dialog-name></h2>
          <p data-dialog-description></p>
          <dl class="product-facts">
            <div><dt data-i18n="home.size">Size</dt><dd data-dialog-size></dd></div>
            <div><dt data-i18n="home.profile">Scent profile</dt><dd data-dialog-notes></dd></div>
            <div><dt data-i18n="home.composition">Composition</dt><dd data-dialog-composition></dd></div>
          </dl>
          <button class="dialog-add" type="button" data-dialog-add><span data-i18n="home.add">Add to cart</span></button>
        </div>
      </div>
    </div>
  </dialog>

  <aside class="cart-panel" id="cart-panel" data-cart-panel data-whatsapp-base={whatsappBaseUrl} aria-hidden="true" aria-labelledby="cart-title">
    <div class="cart-panel-head">
      <div>
        <p class="eyebrow" data-i18n="home.selection">Your selection</p>
        <h2 id="cart-title" data-i18n="home.cartTitle">Cart</h2>
      </div>
      <button class="dialog-close" type="button" data-cart-close aria-label="Close cart" data-i18n-aria-label="home.dialogClose"><span data-i18n="home.dialogClose">Close</span></button>
    </div>
    <div class="cart-items" data-cart-items>
      <p class="cart-empty" data-i18n="home.cartEmpty">Your cart is empty. Add a bottle to begin.</p>
    </div>
    <div class="cart-panel-foot">
      <p class="cart-note" data-i18n="home.cartNote">No prices are shown yet. WhatsApp is used to confirm the current batch, cost and delivery.</p>
      <a class="cart-whatsapp" data-cart-whatsapp href={whatsappUrl("Hi H&N Scents, I would like to ask about the collection.")} target="_blank" rel="noreferrer"><span data-i18n="home.send">Send cart to WhatsApp</span> <span aria-hidden="true">↗</span></a>
      <button class="cart-clear" type="button" data-cart-clear><span data-i18n="home.clear">Clear cart</span></button>
    </div>
  </aside>
  <button class="cart-scrim" type="button" data-cart-close aria-label="Close cart"></button>

  <footer>
    <a class="brand-lockup" href="#top">
      <img src={withBase("/brand/Logo.jpeg")} alt="" width="38" height="38" />
      <span class="wordmark">Heaven <i>&amp;</i> Nature</span>
    </a>
    <p data-i18n="footer.tagline">Fragrance, held in nature.</p>
    <nav aria-label="Footer links"><a href={withBase("/contact/")}><span data-i18n="footer.contact">Contact</span></a><a href={withBase("/testimonials/")}><span data-i18n="footer.notes">Customer notes</span></a><a href={whatsappUrl("Hi H&N Scents, I would like to ask about the collection.")} target="_blank" rel="noreferrer"><span data-i18n="footer.shop">Shop on WhatsApp</span></a><a href={withBase("/privacy/")}><span data-i18n="footer.privacy">Privacy</span></a><a href={withBase("/terms/")}><span data-i18n="footer.terms">Terms</span></a></nav>
    <p>© {new Date().getFullYear()} Heaven &amp; Nature</p>
  </footer>
</BaseLayout>

<script type="application/json" id="catalogue-data" is:inline set:html={catalogueJson}></script>

<script>
  type CartLine = { slug: string; quantity: number };
  type Product = {
    slug: string;
    name: string;
    image?: string;
    imageAlt?: string;
    description: string;
    notes: string[];
    composition: string;
    size?: string;
  };

  const dataNode = document.querySelector<HTMLScriptElement>("#catalogue-data");
  const products = (dataNode ? JSON.parse(dataNode.textContent || "[]") : []) as Product[];
  const productBySlug = new Map<string, Product>(products.map((product) => [product.slug, product]));
  const storageKey = "heaven-and-nature-cart";
  const whatsappBase = document.querySelector<HTMLElement>("[data-whatsapp-base]")?.dataset.whatsappBase || "https://wa.me/9231801946060";
  let cart: CartLine[] = [];
  const localized = (key: string, fallback: string) => {
    const current = (window as Window & { hnI18n?: { get: (key: string, fallback?: string) => string } }).hnI18n;
    return current?.get(key, fallback) || fallback;
  };

  try {
    const stored = JSON.parse(localStorage.getItem(storageKey) || "[]") as CartLine[];
    cart = Array.isArray(stored) ? stored.filter((line: CartLine) => productBySlug.has(line.slug) && line.quantity > 0) : [];
  } catch {
    cart = [];
  }

  const countNodes = [...document.querySelectorAll<HTMLElement>("[data-cart-count]")];
  const panel = document.querySelector<HTMLElement>("[data-cart-panel]");
  const scrim = document.querySelector<HTMLElement>("[data-cart-close].cart-scrim");
  const cartItems = document.querySelector<HTMLElement>("[data-cart-items]");
  const cartWhatsapp = document.querySelector<HTMLAnchorElement>("[data-cart-whatsapp]");
  const dialog = document.querySelector<HTMLDialogElement>("[data-product-dialog]");
  const categoryButtons = [...document.querySelectorAll<HTMLButtonElement>("[data-category-filter]")];
  const categoryItems = [...document.querySelectorAll<HTMLElement>("[data-product-card]")];
  const categoryStatus = document.querySelector<HTMLElement>("[data-category-filter-status]");
  let dialogSlug = "";

  const saveCart = () => localStorage.setItem(storageKey, JSON.stringify(cart));
  const cartCount = () => cart.reduce((total, line) => total + line.quantity, 0);
  const messageForCart = () => {
    const lines = cart.map((line) => {
      const product = productBySlug.get(line.slug);
      return product ? `• ${product.name} × ${line.quantity}` : "";
    }).filter(Boolean);
    return lines.length
      ? `Hi H&N Scents, I would like to ask about:\n${lines.join("\n")}\n\nPlease confirm the current cost and delivery.`
      : "Hi H&N Scents, I would like to ask about the collection.";
  };

  const escapeHtml = (value: string) => value.replace(/[&<>"']/g, (character) => ({
    "&": "&amp;",
    "<": "&lt;",
    ">": "&gt;",
    '"': "&quot;",
    "'": "&#039;"
  }[character] || character));

  const renderCart = () => {
    const count = cartCount();
    countNodes.forEach((node) => { node.textContent = String(count); });
    if (cartWhatsapp) cartWhatsapp.href = `${whatsappBase}?text=${encodeURIComponent(messageForCart())}`;
    if (!cartItems) return;
    if (!cart.length) {
      cartItems.innerHTML = `<p class="cart-empty">${localized("home.cartEmpty", "Your cart is empty. Add a bottle to begin.")}</p>`;
      return;
    }
    cartItems.innerHTML = cart.map((line) => {
      const product = productBySlug.get(line.slug);
      return product ? `<div class="cart-line" data-cart-line="${escapeHtml(product.slug)}">
        <div><strong>${escapeHtml(product.name)}</strong><span>${escapeHtml(product.size || localized("home.detailsConfirm", "Details to be confirmed"))}</span></div>
        <div class="cart-quantity"><button type="button" data-cart-decrease="${escapeHtml(product.slug)}" aria-label="Remove one ${escapeHtml(product.name)}">−</button><span>${line.quantity}</span><button type="button" data-cart-increase="${escapeHtml(product.slug)}" aria-label="Add one ${escapeHtml(product.name)}">＋</button></div>
      </div>` : "";
    }).join("");
  };

  const setCartOpen = (open: boolean) => {
    if (!panel || !scrim) return;
    panel.classList.toggle("is-open", open);
    panel.setAttribute("aria-hidden", String(!open));
    scrim.classList.toggle("is-visible", open);
    document.querySelectorAll<HTMLElement>("[data-cart-open]").forEach((button) => button.setAttribute("aria-expanded", String(open)));
    if (open) panel.querySelector<HTMLButtonElement>("[data-cart-close]")?.focus();
  };

  const addToCart = (slug: string) => {
    const line = cart.find((item) => item.slug === slug);
    if (line) line.quantity += 1;
    else cart.push({ slug, quantity: 1 });
    saveCart();
    renderCart();
    setCartOpen(true);
  };

  const updateQuantity = (slug: string, delta: number) => {
    const line = cart.find((item) => item.slug === slug);
    if (!line) return;
    line.quantity += delta;
    cart = cart.filter((item) => item.quantity > 0);
    saveCart();
    renderCart();
  };

  const applyCategory = (category: string) => {
    const visibleCount = categoryItems.filter((item) => {
      const visible = category === "all" || item.dataset.category === category;
      item.hidden = !visible;
      return visible;
    }).length;
    categoryButtons.forEach((button) => {
      const active = button.dataset.categoryFilter === category;
      button.classList.toggle("is-active", active);
      button.setAttribute("aria-pressed", String(active));
    });
    if (categoryStatus) {
      const fallback = category === "all"
        ? "Showing all six references."
        : `${visibleCount} ${visibleCount === 1 ? "reference" : "references"} in this style.`;
      categoryStatus.textContent = localized(category === "all" ? "home.categoryStatusAll" : "home.categoryStatusFiltered", fallback)
        .replace("{count}", String(visibleCount));
    }
  };

  document.querySelectorAll<HTMLElement>("[data-cart-open]").forEach((button) => button.addEventListener("click", () => setCartOpen(true)));
  document.querySelectorAll<HTMLElement>("[data-cart-close]").forEach((button) => button.addEventListener("click", () => setCartOpen(false)));
  document.querySelector<HTMLElement>("[data-cart-clear]")?.addEventListener("click", () => { cart = []; saveCart(); renderCart(); });
  document.addEventListener("click", (event) => {
    const target = event.target as HTMLElement;
    const addButton = target.closest<HTMLElement>("[data-add-to-cart]");
    if (addButton) addToCart(addButton.dataset.addToCart || "");
    const increase = target.closest<HTMLElement>("[data-cart-increase]");
    if (increase) updateQuantity(increase.dataset.cartIncrease || "", 1);
    const decrease = target.closest<HTMLElement>("[data-cart-decrease]");
    if (decrease) updateQuantity(decrease.dataset.cartDecrease || "", -1);
  });

  categoryButtons.forEach((button) => button.addEventListener("click", () => applyCategory(button.dataset.categoryFilter || "all")));

  const openDetails = (slug: string) => {
    const product = productBySlug.get(slug);
    if (!product || !dialog) return;
    dialogSlug = slug;
    const image = dialog.querySelector<HTMLImageElement>("[data-dialog-image]");
    if (image) { image.src = product.image || ""; image.alt = product.imageAlt || product.name; }
    dialog.querySelector<HTMLElement>("[data-dialog-name]")!.textContent = product.name;
    dialog.querySelector<HTMLElement>("[data-dialog-description]")!.textContent = product.description;
    dialog.querySelector<HTMLElement>("[data-dialog-size]")!.textContent = product.size || localized("home.detailsConfirm", "Details to be confirmed");
    dialog.querySelector<HTMLElement>("[data-dialog-notes]")!.textContent = product.notes.join(" · ");
    dialog.querySelector<HTMLElement>("[data-dialog-composition]")!.textContent = product.composition;
    dialog.showModal();
  };

  document.querySelectorAll<HTMLElement>("[data-product-details]").forEach((button) => button.addEventListener("click", () => openDetails(button.dataset.productDetails || "")));
  document.querySelector<HTMLElement>("[data-dialog-close]")?.addEventListener("click", () => dialog?.close());
  document.querySelector<HTMLElement>("[data-dialog-add]")?.addEventListener("click", () => { addToCart(dialogSlug); dialog?.close(); });
  dialog?.addEventListener("click", (event) => { if (event.target === dialog) dialog.close(); });

  window.addEventListener("hn:localechange", () => {
    renderCart();
    const active = categoryButtons.find((button) => button.classList.contains("is-active"));
    applyCategory(active?.dataset.categoryFilter || "all");
  });
  renderCart();
  applyCategory("all");
</script>
