---
import BaseLayout from "../layouts/BaseLayout.astro";
import BatchCard from "../components/BatchCard.astro";
import StructuredData from "../components/StructuredData.astro";
import { batches } from "../data/batches";
import { absoluteUrl, configuredSiteUrl, site, withBase } from "../data/site";

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: site.name,
  description: site.description,
  logo: configuredSiteUrl ? absoluteUrl("/brand/Logo.jpeg") : undefined,
  url: configuredSiteUrl ? absoluteUrl("/") : undefined,
  areaServed: {
    "@type": "Country",
    name: site.location
  }
};
---

<BaseLayout>
  <StructuredData data={organizationSchema} />
  <header class="site-header">
    <a class="brand-lockup" href="#top" aria-label="Heaven and Nature home">
      <img src={withBase("/brand/Logo.jpeg")} alt="" width="38" height="38" />
      <span class="wordmark">Heaven <i>&amp;</i> Nature</span>
    </a>
    <nav class="site-nav" aria-label="Main navigation">
      <a href="#collection">The bottles</a>
      <a href="#story">Packaging</a>
    </nav>
  </header>

  <main id="main">
    <section class="hero" id="top" aria-labelledby="hero-title">
      <figure class="hero-still-life">
        <img src={withBase("/batches/collection-flat-lay.jpg")} alt="A selection of H&N Scents perfume bottles arranged around a presentation box." width="1200" height="1500" />
      </figure>
      <div class="hero-copy">
        <p class="eyebrow">Heaven &amp; Nature · Pakistan</p>
        <h1 id="hero-title">H&amp;N Scents</h1>
        <p class="hero-intro">A photographic catalogue of the bottles, labels and presentation pieces currently shared by the brand.</p>
        <a class="text-link" href="#collection">See the bottles</a>
      </div>
    </section>

    <section class="collection" id="collection" aria-labelledby="collection-title">
      <div class="section-heading">
        <p class="eyebrow">Bottle catalogue</p>
        <h2 id="collection-title">Six bottle references</h2>
        <p>These six bottles are shown as a visual reference from the supplied H&amp;N Scents photography. Availability and ordering will be added after confirmation.</p>
      </div>
      {batches.length ? (
        <ul class="catalogue-grid">
          {batches.map((batch) => <BatchCard batch={batch} />)}
        </ul>
      ) : (
        <p class="empty-state">The first release will be announced here.</p>
      )}
    </section>

    <section class="craft" id="story" aria-labelledby="craft-title">
      <figure class="craft-art">
        <img src={withBase("/batches/presentation-box.jpg")} alt="An open H&N Scents presentation box beside its closed floral box." width="1200" height="1200" loading="lazy" decoding="async" />
      </figure>
      <div class="craft-copy">
        <p class="eyebrow">Packaging details</p>
        <h2 id="craft-title">The bottle, clearly.</h2>
        <p>Clear glass keeps the liquid visible. The wooden cap adds warmth. The printed label gives each bottle its own character.</p>
        <p class="quiet">This is a catalogue of supplied product photography, not a checkout. Details will be updated as launches are confirmed.</p>
      </div>
    </section>
  </main>

  <footer>
    <a class="brand-lockup" href="#top">
      <img src={withBase("/brand/Logo.jpeg")} alt="" width="38" height="38" />
      <span class="wordmark">Heaven <i>&amp;</i> Nature</span>
    </a>
    <p>Fragrance, held in nature.</p>
    <nav aria-label="Legal links"><a href={withBase("/privacy/")}>Privacy</a><a href={withBase("/terms/")}>Terms</a></nav>
    <p>© {new Date().getFullYear()} Heaven &amp; Nature</p>
  </footer>
</BaseLayout>
