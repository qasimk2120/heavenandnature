---
import BaseLayout from "../layouts/BaseLayout.astro";
import BatchCard from "../components/BatchCard.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import StructuredData from "../components/StructuredData.astro";
import { batches } from "../data/batches";
import { absoluteUrl, configuredSiteUrl, site, whatsappBaseUrl, whatsappUrl, withBase } from "../data/site";

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: site.name,
  description: site.description,
  "@id": configuredSiteUrl ? absoluteUrl("/#organization") : undefined,
  logo: configuredSiteUrl ? absoluteUrl("/brand/Log.png") : undefined,
  url: configuredSiteUrl ? absoluteUrl("/") : undefined,
  areaServed: {
    "@type": "Country",
    name: site.location
  }
};

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: site.name,
  description: site.description,
  url: configuredSiteUrl ? absoluteUrl("/") : undefined,
  inLanguage: "en-PK",
  publisher: { "@id": configuredSiteUrl ? absoluteUrl("/#organization") : undefined }
};

const catalogueSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "H&N Scents fragrance catalogue",
  description: "Owner-supplied visual references for H&N Scents fragrances and presentation.",
  numberOfItems: batches.length,
  itemListElement: batches.map((batch, index) => ({
    "@type": "ListItem",
    position: index + 1,
    name: batch.name,
    description: batch.shortDescription,
    image: batch.image && configuredSiteUrl ? absoluteUrl(batch.image) : undefined
  }))
};

const catalogueJson = JSON.stringify(batches).replace(/</g, "\\u003c");
---

<BaseLayout
  title="H&N Scents | Heaven & Nature perfume in Pakistan"
  description="Explore H&N Scents fragrances, scent profiles and presentation details. Ask about availability and delivery throughout Pakistan on WhatsApp."
  path="/"
  image="/og/home-og.jpg"
>
  <StructuredData data={[organizationSchema, websiteSchema, catalogueSchema]} />
  <SiteHeader showCart />

  <main id="main" class="home-page">
    <section class="hero" id="top" aria-labelledby="hero-title">
      <h1 id="hero-title" class="sr-only">Heaven &amp; Nature fragrances</h1>
      <figure class="hero-still-life">
        <img src={withBase("/batches/collection-bloom-hero.jpeg")} alt="H&N Scents perfumes with wooden caps among blossoms, greenery, stone and driftwood." width="1600" height="900" fetchpriority="high" decoding="async" />
      </figure>
    </section>

    <section class="collection" id="collection" aria-labelledby="collection-title">
      <h2 id="collection-title" class="sr-only">Fragrance collection</h2>
      <div class="catalogue-filters" aria-label="Browse fragrances">
        <div class="category-filter-list" role="group" aria-label="Audience filters">
          <button class="category-filter is-active" type="button" data-category-filter="all" aria-pressed="true" data-i18n="home.audienceAll">All</button>
          <button class="category-filter" type="button" data-category-filter="unisex" aria-pressed="false" data-i18n="home.audienceUnisex">Unisex</button>
          <button class="category-filter" type="button" data-category-filter="male" aria-pressed="false" data-i18n="home.audienceMen">Men</button>
          <button class="category-filter" type="button" data-category-filter="female" aria-pressed="false" data-i18n="home.audienceWomen">Women</button>
        </div>
        <div class="catalogue-tools">
          <label class="style-filter">
            <span class="sr-only" data-i18n="home.filterByStyle">Filter by scent style</span>
            <select data-style-filter aria-label="Filter by scent style" data-i18n-aria-label="home.filterByStyle">
              <option value="all" data-i18n="home.filter">Filter</option>
              <option value="fresh" data-i18n="home.categoryFresh">Fresh</option>
              <option value="floral" data-i18n="home.categoryFloral">Floral</option>
              <option value="woody" data-i18n="home.categoryWoody">Woody</option>
              <option value="oud" data-i18n="home.categoryOud">Oud</option>
            </select>
          </label>
          <span class="tool-divider" aria-hidden="true">/</span>
          <label class="catalogue-search">
            <span class="sr-only">Search fragrances</span>
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"></circle><path d="m15.5 15.5 5 5"></path></svg>
            <input type="search" data-catalogue-search placeholder="Search" aria-label="Search fragrances" data-i18n-placeholder="home.searchShort" data-i18n-aria-label="home.searchPlaceholder" />
          </label>
        </div>
      </div>
      <p class="sr-only" data-category-filter-status aria-live="polite"></p>
      {batches.length ? (
        <ul class="catalogue-grid">
          {batches.map((batch) => <BatchCard batch={batch} />)}
        </ul>
      ) : (
        <p class="empty-state">The first release will be announced here.</p>
      )}
      <p class="catalogue-empty" data-catalogue-empty hidden>No fragrances match this search.</p>
    </section>
  </main>

  <dialog class="product-dialog" data-product-dialog aria-labelledby="product-dialog-title">
    <div class="product-dialog-inner">
      <button class="dialog-close" type="button" data-dialog-close aria-label="Close product details" data-i18n-aria-label="home.dialogClose"><span data-i18n="home.dialogClose">Close</span></button>
      <div class="product-dialog-grid">
        <figure class="product-dialog-image"><img data-dialog-image src="" alt="" /></figure>
        <div class="product-dialog-copy">
          <p class="eyebrow" data-i18n="home.detailsEyebrow">Fragrance details</p>
          <h2 id="product-dialog-title" data-dialog-name></h2>
          <p class="detail-price" data-dialog-price><del data-dialog-original></del><span data-dialog-sale></span></p>
          <dl class="product-facts">
            <div data-dialog-size-row><dt data-i18n="home.size">Size</dt><dd data-dialog-size></dd></div>
            <div data-dialog-inspired-row><dt data-i18n="home.inspiredBy">Inspired by</dt><dd data-dialog-inspired></dd></div>
            <div data-dialog-notes-row><dt data-i18n="home.profile">Scent profile</dt><dd data-dialog-notes></dd></div>
          </dl>
          <button class="dialog-add" type="button" data-dialog-add><span data-i18n="home.add">Add to cart</span></button>
        </div>
      </div>
    </div>
  </dialog>

  <aside class="cart-panel" id="cart-panel" data-cart-panel data-whatsapp-base={whatsappBaseUrl} aria-hidden="true" aria-labelledby="cart-title">
    <div class="cart-panel-head">
      <div>
        <p class="eyebrow" data-i18n="home.selection">Your selection</p>
        <h2 id="cart-title" data-i18n="home.cartTitle">Cart</h2>
      </div>
      <button class="dialog-close" type="button" data-cart-close aria-label="Close cart" data-i18n-aria-label="home.dialogClose"><span data-i18n="home.dialogClose">Close</span></button>
    </div>
    <div class="cart-items" data-cart-items>
      <p class="cart-empty" data-i18n="home.cartEmpty">Your cart is empty. Add a fragrance to begin.</p>
    </div>
    <div class="cart-panel-foot">
      <p class="cart-note" data-i18n="home.cartNote">Confirm current price, availability and delivery on WhatsApp.</p>
      <a class="cart-whatsapp" data-cart-whatsapp href={whatsappUrl("Hi H&N Scents, I would like to ask about the collection.")} target="_blank" rel="noreferrer"><span data-i18n="home.send">Send cart to WhatsApp</span> <span aria-hidden="true">↗</span></a>
      <button class="cart-clear" type="button" data-cart-clear><span data-i18n="home.clear">Clear cart</span></button>
    </div>
  </aside>
  <button class="cart-scrim" type="button" data-cart-close aria-label="Close cart"></button>

  <SiteFooter />
</BaseLayout>

<script type="application/json" id="catalogue-data" is:inline set:html={catalogueJson}></script>

<script>
  type CartLine = { slug: string; quantity: number };
  type Product = {
    slug: string;
    name: string;
    image?: string;
    imageAlt?: string;
    inspiredBy?: string;
    notes: string[];
    size?: string;
    price?: number;
    originalPrice?: number;
  };

  const dataNode = document.querySelector<HTMLScriptElement>("#catalogue-data");
  const products = (dataNode ? JSON.parse(dataNode.textContent || "[]") : []) as Product[];
  const productBySlug = new Map<string, Product>(products.map((product) => [product.slug, product]));
  const storageKey = "heaven-and-nature-cart";
  const whatsappBase = document.querySelector<HTMLElement>("[data-whatsapp-base]")?.dataset.whatsappBase || "https://wa.me/923180194606";
  let cart: CartLine[] = [];
  const localized = (key: string, fallback: string) => {
    const current = (window as Window & { hnI18n?: { get: (key: string, fallback?: string) => string } }).hnI18n;
    return current?.get(key, fallback) || fallback;
  };

  try {
    const stored = JSON.parse(localStorage.getItem(storageKey) || "[]") as CartLine[];
    cart = Array.isArray(stored) ? stored.filter((line: CartLine) => productBySlug.has(line.slug) && line.quantity > 0) : [];
  } catch {
    cart = [];
  }

  const countNodes = [...document.querySelectorAll<HTMLElement>("[data-cart-count]")];
  const panel = document.querySelector<HTMLElement>("[data-cart-panel]");
  const scrim = document.querySelector<HTMLElement>("[data-cart-close].cart-scrim");
  const cartItems = document.querySelector<HTMLElement>("[data-cart-items]");
  const cartWhatsapp = document.querySelector<HTMLAnchorElement>("[data-cart-whatsapp]");
  const dialog = document.querySelector<HTMLDialogElement>("[data-product-dialog]");
  const categoryButtons = [...document.querySelectorAll<HTMLButtonElement>("[data-category-filter]")];
  const categoryItems = [...document.querySelectorAll<HTMLElement>("[data-product-card]")];
  const categoryStatus = document.querySelector<HTMLElement>("[data-category-filter-status]");
  const searchInput = document.querySelector<HTMLInputElement>("[data-catalogue-search]");
  const styleFilter = document.querySelector<HTMLSelectElement>("[data-style-filter]");
  const requestedStyle = new URLSearchParams(window.location.search).get("style");
  if (styleFilter && requestedStyle && [...styleFilter.options].some((option) => option.value === requestedStyle)) {
    styleFilter.value = requestedStyle;
  }
  const emptyMessage = document.querySelector<HTMLElement>("[data-catalogue-empty]");
  let dialogSlug = "";

  const saveCart = () => localStorage.setItem(storageKey, JSON.stringify(cart));
  const cartCount = () => cart.reduce((total, line) => total + line.quantity, 0);
  const formatPrice = (price: number) => `PKR ${price.toLocaleString("en-PK")}`;
  const messageForCart = () => {
    const lines = cart.map((line) => {
      const product = productBySlug.get(line.slug);
      return product ? `• ${product.name} × ${line.quantity}${product.price !== undefined ? ` (${formatPrice(product.price)} each)` : ""}` : "";
    }).filter(Boolean);
    return lines.length
      ? `Hi H&N Scents, I would like to ask about:\n${lines.join("\n")}\n\nPlease confirm the current cost and delivery.`
      : "Hi H&N Scents, I would like to ask about the collection.";
  };

  const escapeHtml = (value: string) => value.replace(/[&<>"']/g, (character) => ({
    "&": "&amp;",
    "<": "&lt;",
    ">": "&gt;",
    '"': "&quot;",
    "'": "&#039;"
  }[character] || character));

  const renderCart = () => {
    const count = cartCount();
    countNodes.forEach((node) => { node.textContent = String(count); });
    if (cartWhatsapp) cartWhatsapp.href = `${whatsappBase}?text=${encodeURIComponent(messageForCart())}`;
    if (!cartItems) return;
    if (!cart.length) {
      cartItems.innerHTML = `<p class="cart-empty">${localized("home.cartEmpty", "Your cart is empty. Add a fragrance to begin.")}</p>`;
      return;
    }
    cartItems.innerHTML = cart.map((line) => {
      const product = productBySlug.get(line.slug);
      return product ? `<div class="cart-line" data-cart-line="${escapeHtml(product.slug)}">
        <div><strong>${escapeHtml(product.name)}</strong><span>${escapeHtml([product.size, product.price !== undefined ? formatPrice(product.price) : ""].filter(Boolean).join(" · "))}</span></div>
        <div class="cart-quantity"><button type="button" data-cart-decrease="${escapeHtml(product.slug)}" aria-label="Remove one ${escapeHtml(product.name)}">−</button><span>${line.quantity}</span><button type="button" data-cart-increase="${escapeHtml(product.slug)}" aria-label="Add one ${escapeHtml(product.name)}">＋</button></div>
      </div>` : "";
    }).join("");
  };

  const setCartOpen = (open: boolean) => {
    if (!panel || !scrim) return;
    panel.classList.toggle("is-open", open);
    panel.setAttribute("aria-hidden", String(!open));
    scrim.classList.toggle("is-visible", open);
    document.querySelectorAll<HTMLElement>("[data-cart-open]").forEach((button) => button.setAttribute("aria-expanded", String(open)));
    if (open) panel.querySelector<HTMLButtonElement>("[data-cart-close]")?.focus();
  };

  const addToCart = (slug: string) => {
    const line = cart.find((item) => item.slug === slug);
    if (line) line.quantity += 1;
    else cart.push({ slug, quantity: 1 });
    saveCart();
    renderCart();
    setCartOpen(true);
  };

  const updateQuantity = (slug: string, delta: number) => {
    const line = cart.find((item) => item.slug === slug);
    if (!line) return;
    line.quantity += delta;
    cart = cart.filter((item) => item.quantity > 0);
    saveCart();
    renderCart();
  };

  const applyCategory = (category: string) => {
    const query = searchInput?.value.trim().toLocaleLowerCase() || "";
    const visibleCount = categoryItems.filter((item) => {
      const product = productBySlug.get(item.dataset.productSlug || "");
      const haystack = [product?.name, product?.inspiredBy, product?.notes.join(" ")].filter(Boolean).join(" ").toLocaleLowerCase();
      const visible = (category === "all" || item.dataset.audience === category)
        && (styleFilter?.value === "all" || item.dataset.category === styleFilter?.value)
        && haystack.includes(query);
      item.hidden = !visible;
      return visible;
    }).length;
    categoryButtons.forEach((button) => {
      const active = button.dataset.categoryFilter === category;
      button.classList.toggle("is-active", active);
      button.setAttribute("aria-pressed", String(active));
    });
    if (emptyMessage) {
      emptyMessage.hidden = visibleCount > 0;
      emptyMessage.textContent = query
        ? localized("home.searchEmpty", "No fragrances match this search.")
        : category !== "all"
          ? localized("home.audiencePending", "This category is being confirmed.")
          : localized("home.searchEmpty", "No fragrances match this search.");
    }
    if (categoryStatus) categoryStatus.textContent = `${visibleCount} ${visibleCount === 1 ? "fragrance" : "fragrances"} shown.`;
  };

  const localizeCardActions = () => {
    categoryItems.forEach((item) => {
      const name = productBySlug.get(item.dataset.productSlug || "")?.name;
      if (!name) return;
      const add = item.querySelector<HTMLButtonElement>("[data-add-to-cart]");
      const ask = item.querySelector<HTMLAnchorElement>(".catalogue-ask");
      if (add) add.setAttribute("aria-label", `${localized("home.add", "Add to cart")}: ${name}`);
      if (ask) ask.setAttribute("aria-label", `${localized("home.ask", "Ask on WhatsApp")}: ${name}`);
    });
  };

  document.querySelectorAll<HTMLElement>("[data-cart-open]").forEach((button) => button.addEventListener("click", () => setCartOpen(true)));
  document.querySelectorAll<HTMLElement>("[data-cart-close]").forEach((button) => button.addEventListener("click", () => setCartOpen(false)));
  document.querySelector<HTMLElement>("[data-cart-clear]")?.addEventListener("click", () => { cart = []; saveCart(); renderCart(); });
  document.addEventListener("click", (event) => {
    const target = event.target as HTMLElement;
    const addButton = target.closest<HTMLElement>("[data-add-to-cart]");
    if (addButton) addToCart(addButton.dataset.addToCart || "");
    const increase = target.closest<HTMLElement>("[data-cart-increase]");
    if (increase) updateQuantity(increase.dataset.cartIncrease || "", 1);
    const decrease = target.closest<HTMLElement>("[data-cart-decrease]");
    if (decrease) updateQuantity(decrease.dataset.cartDecrease || "", -1);
  });

  categoryButtons.forEach((button) => button.addEventListener("click", () => applyCategory(button.dataset.categoryFilter || "all")));
  styleFilter?.addEventListener("change", () => {
    const active = categoryButtons.find((button) => button.classList.contains("is-active"));
    applyCategory(active?.dataset.categoryFilter || "all");
  });
  searchInput?.addEventListener("input", () => {
    const active = categoryButtons.find((button) => button.classList.contains("is-active"));
    applyCategory(active?.dataset.categoryFilter || "all");
  });

  const openDetails = (slug: string) => {
    const product = productBySlug.get(slug);
    if (!product || !dialog) return;
    dialogSlug = slug;
    const image = dialog.querySelector<HTMLImageElement>("[data-dialog-image]");
    if (image) { image.src = product.image || ""; image.alt = product.imageAlt || product.name; }
    dialog.querySelector<HTMLElement>("[data-dialog-name]")!.textContent = product.name;
    const price = dialog.querySelector<HTMLElement>("[data-dialog-price]");
    if (price) price.hidden = product.price === undefined;
    const original = dialog.querySelector<HTMLElement>("[data-dialog-original]");
    if (original) { original.hidden = product.originalPrice === undefined; original.textContent = product.originalPrice !== undefined ? formatPrice(product.originalPrice) : ""; }
    dialog.querySelector<HTMLElement>("[data-dialog-sale]")!.textContent = product.price !== undefined ? formatPrice(product.price) : "";
    const sizeRow = dialog.querySelector<HTMLElement>("[data-dialog-size-row]");
    if (sizeRow) sizeRow.hidden = !product.size;
    dialog.querySelector<HTMLElement>("[data-dialog-size]")!.textContent = product.size || "";
    const inspiredRow = dialog.querySelector<HTMLElement>("[data-dialog-inspired-row]");
    if (inspiredRow) inspiredRow.hidden = !product.inspiredBy;
    dialog.querySelector<HTMLElement>("[data-dialog-inspired]")!.textContent = product.inspiredBy || "";
    const notesRow = dialog.querySelector<HTMLElement>("[data-dialog-notes-row]");
    if (notesRow) notesRow.hidden = !product.notes.length;
    dialog.querySelector<HTMLElement>("[data-dialog-notes]")!.textContent = product.notes.join(" · ");
    dialog.showModal();
  };

  document.querySelectorAll<HTMLElement>("[data-product-details]").forEach((button) => button.addEventListener("click", () => openDetails(button.dataset.productDetails || "")));
  document.querySelector<HTMLElement>("[data-dialog-close]")?.addEventListener("click", () => dialog?.close());
  document.querySelector<HTMLElement>("[data-dialog-add]")?.addEventListener("click", () => { addToCart(dialogSlug); dialog?.close(); });
  dialog?.addEventListener("click", (event) => { if (event.target === dialog) dialog.close(); });

  window.addEventListener("hn:localechange", () => {
    renderCart();
    localizeCardActions();
    const active = categoryButtons.find((button) => button.classList.contains("is-active"));
    applyCategory(active?.dataset.categoryFilter || "all");
  });
  renderCart();
  localizeCardActions();
  applyCategory("all");
</script>
