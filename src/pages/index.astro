---
import BaseLayout from "../layouts/BaseLayout.astro";
import BatchCard from "../components/BatchCard.astro";
import StructuredData from "../components/StructuredData.astro";
import { batches } from "../data/batches";
import { absoluteUrl, configuredSiteUrl, site, withBase } from "../data/site";

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: site.name,
  description: site.description,
  logo: configuredSiteUrl ? absoluteUrl("/brand/Logo.jpeg") : undefined,
  url: configuredSiteUrl ? absoluteUrl("/") : undefined,
  areaServed: {
    "@type": "Country",
    name: site.location
  }
};
---

<BaseLayout>
  <StructuredData data={organizationSchema} />
  <header class="site-header">
    <a class="brand-lockup" href="#top" aria-label="Heaven and Nature home">
      <img src={withBase("/brand/Logo.jpeg")} alt="" width="38" height="38" />
      <span class="wordmark">Heaven <i>&amp;</i> Nature</span>
    </a>
    <a class="header-link" href="#collection">Explore releases <span aria-hidden="true">↓</span></a>
  </header>

  <main id="main">
    <section class="hero" id="top" aria-labelledby="hero-title">
      <div class="hero-copy reveal">
        <p class="eyebrow">Pakistan · independent fragrance</p>
        <h1 id="hero-title">A little heaven.<br /><em>Held by nature.</em></h1>
        <p class="hero-intro">Transparent glass, a considered label and a wooden cap. Heaven &amp; Nature makes room for fragrance to speak quietly.</p>
        <a class="text-link" href="#collection">See the current release <span aria-hidden="true">→</span></a>
      </div>
      <figure class="hero-still-life reveal">
        <img src={withBase("/batches/collection-flat-lay.jpg")} alt="A selection of H&N Scents perfume bottles arranged around a presentation box." width="1200" height="1500" />
        <figcaption>From the opening collection</figcaption>
      </figure>
    </section>

    <section class="collection" id="collection" aria-labelledby="collection-title">
      <div class="section-heading reveal">
        <p class="eyebrow">Current &amp; forthcoming</p>
        <h2 id="collection-title">The collection</h2>
        <p>A first look at the bottle collection. Release, ordering and fragrance details follow when the brand confirms them.</p>
      </div>
      {batches.length ? (
        <div class="batch-grid">
          {batches.map((batch) => <BatchCard batch={batch} />)}
        </div>
      ) : (
        <p class="empty-state reveal">The first release will be announced here.</p>
      )}
    </section>

    <section class="craft" id="story" aria-labelledby="craft-title">
      <div class="craft-art reveal" aria-hidden="true">
        <div class="wood-grain grain-one"></div>
        <div class="wood-grain grain-two"></div>
        <div class="wood-grain grain-three"></div>
        <div class="glass-orb"></div>
      </div>
      <div class="craft-copy reveal">
        <p class="eyebrow">The object</p>
        <h2 id="craft-title">Made to sit beautifully.</h2>
        <p>Clear glass keeps the colour of each fragrance visible. The cap brings warmth. The label gives every bottle its own place.</p>
        <p class="quiet">The collection is photographed as it takes shape; final release and fragrance details are added only when they are confirmed.</p>
      </div>
    </section>

    <section class="contact reveal" id="contact" aria-labelledby="contact-title">
      <p class="eyebrow">Stay close</p>
      <h2 id="contact-title">The next release is taking shape.</h2>
      <p>Ordering details and official channels will appear here with the first launch.</p>
      <span class="contact-status">Contact to be confirmed</span>
    </section>
  </main>

  <footer>
    <a class="brand-lockup" href="#top">
      <img src={withBase("/brand/Logo.jpeg")} alt="" width="38" height="38" />
      <span class="wordmark">Heaven <i>&amp;</i> Nature</span>
    </a>
    <p>Fragrance, held in nature.</p>
    <p>© {new Date().getFullYear()} Heaven &amp; Nature</p>
  </footer>
</BaseLayout>
