---
import BaseLayout from "../../layouts/BaseLayout.astro";
import StructuredData from "../../components/StructuredData.astro";
import { absoluteUrl, site, whatsappBaseUrl, whatsappDisplayNumber, whatsappTelephone, whatsappUrl, withBase } from "../../data/site";

const contactSchema = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  name: `Contact ${site.name}`,
  description: "Contact Heaven & Nature about fragrance batches, availability and delivery throughout Pakistan.",
  url: absoluteUrl("/contact/"),
  about: { "@type": "Organization", name: site.name, areaServed: site.location },
  mainEntity: {
    "@type": "ContactPoint",
    telephone: whatsappTelephone,
    contactType: "customer service",
    areaServed: "PK",
    availableLanguage: ["English", "Urdu", "Pashto", "Punjabi", "Sindhi"]
  }
};
---

<BaseLayout
  title="Contact | Heaven & Nature"
  description="Contact Heaven & Nature about fragrance batches, availability and delivery throughout Pakistan."
  path="/contact/"
>
  <StructuredData data={contactSchema} />

  <main id="main" class="contact-page">
    <section class="inner-hero contact-hero" aria-labelledby="contact-title">
      <div class="inner-hero-copy">
        <h1 id="contact-title" data-i18n="footer.contact">Contact</h1>
        <a class="contact-phone" href={whatsappUrl("Hi H&N Scents, I would like to ask about the collection.")} target="_blank" rel="noreferrer">{whatsappDisplayNumber} <span aria-hidden="true">↗</span></a>
        <a class="contact-call" href={`tel:${whatsappTelephone}`} data-i18n="contact.call">Call this number</a>
      </div>
      <figure class="inner-hero-image"><img src={withBase("/batches/presentation-box.jpg")} alt="H&N Scents presentation box with perfume packaging." width="1200" height="1200" fetchpriority="high" decoding="async" /></figure>
    </section>

    <div class="contact-layout">
      <p class="contact-form-intro" data-i18n="contact.response">Send the scent you’re considering, your city and any question. We’ll confirm the current batch, price and delivery directly.</p>
      <form class="contact-form" id="contact-form">
        <label for="contact-name"><span data-i18n="contact.name">Your name</span> <span data-i18n="contact.optional">optional</span></label>
        <input id="contact-name" name="name" autocomplete="name" />

        <label for="contact-interest" data-i18n="contact.asking">I’m asking about</label>
        <select id="contact-interest" name="interest">
          <option value="a bottle" data-i18n="contact.optionBottle">A bottle</option>
          <option value="a new batch" data-i18n="contact.optionBatch">A new batch</option>
          <option value="gift presentation" data-i18n="contact.optionGift">Gift presentation</option>
          <option value="delivery" data-i18n="contact.optionDelivery">Delivery</option>
          <option value="something else" data-i18n="contact.optionOther">Something else</option>
        </select>

        <label for="contact-message" data-i18n="contact.message">Message</label>
        <textarea id="contact-message" name="message" rows="5" required placeholder="Which scent or question can we help with?" data-i18n-placeholder="contact.placeholder"></textarea>

        <button class="contact-submit" type="submit"><span data-i18n="contact.open">Open WhatsApp</span> <span aria-hidden="true">↗</span></button>
        <p class="contact-status" id="contact-status" role="status" aria-live="polite"></p>
      </form>
    </div>
  </main>

</BaseLayout>

<script is:inline define:vars={{ whatsappBaseUrl }}>
  const form = document.querySelector<HTMLFormElement>("#contact-form");
  const status = document.querySelector<HTMLElement>("#contact-status");

  form?.addEventListener("submit", (event) => {
    event.preventDefault();
    const values = new FormData(form);
    const name = String(values.get("name") || "").trim();
    const interest = String(values.get("interest") || "a bottle");
    const message = String(values.get("message") || "").trim();
    const greeting = name ? `Hi H&N Scents, I’m ${name}.` : "Hi H&N Scents.";
    const text = `${greeting}\nI’m asking about ${interest}.\n\n${message}`;
    window.open(`${whatsappBaseUrl}?text=${encodeURIComponent(text)}`, "_blank", "noopener,noreferrer");
    if (status) status.textContent = "WhatsApp is opening with your message ready to send.";
  });
</script>
