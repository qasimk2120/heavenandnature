---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import StructuredData from "../../components/StructuredData.astro";
import { absoluteUrl, site, whatsappBaseUrl, whatsappUrl, withBase } from "../../data/site";

const contactSchema = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  name: `Contact ${site.name}`,
  description: "Contact Heaven & Nature about fragrance batches, availability and delivery throughout Pakistan.",
  url: absoluteUrl("/contact/"),
  about: { "@type": "Organization", name: site.name, areaServed: site.location },
  mainEntity: {
    "@type": "ContactPoint",
    telephone: "+92 318 01946060",
    contactType: "customer service",
    areaServed: "PK",
    availableLanguage: ["English", "Urdu", "Pashto", "Punjabi", "Sindhi"]
  }
};
---

<BaseLayout
  title="Contact | Heaven & Nature"
  description="Contact Heaven & Nature about fragrance batches, availability and delivery throughout Pakistan."
  path="/contact/"
>
  <StructuredData data={contactSchema} />

  <SiteHeader />

  <main id="main" class="contact-page">
    <div class="contact-heading">
      <p class="eyebrow" data-i18n="contact.eyebrow">A direct line to the brand</p>
      <h1 data-i18n="contact.title">Tell us what you’re looking for</h1>
      <p data-i18n="contact.intro">Ask about a bottle, a new batch, gift presentation or delivery. We’ll take the conversation to WhatsApp and confirm what is currently available.</p>
    </div>

    <div class="contact-layout">
      <div class="contact-details">
        <p class="contact-kicker" data-i18n="contact.good">Good to know</p>
        <p class="contact-highlight" data-i18n="contact.delivery">Delivery throughout Pakistan.</p>
        <p class="contact-muted" data-i18n="contact.noCheckout">Prices and availability are confirmed directly with the brand. There is no payment or account checkout on this site.</p>
        <div class="contact-languages" aria-label="Supported enquiry languages">
          <p class="contact-kicker" data-i18n="contact.languageLabel">Languages</p>
          <p data-i18n="contact.languages">English · Urdu · Pashto · Punjabi · Sindhi</p>
        </div>
        <a class="contact-phone" href={whatsappUrl("Hi H&N Scents, I would like to ask about the collection.")} target="_blank" rel="noreferrer">+92 318 01946060 <span aria-hidden="true">↗</span></a>
      </div>

      <form class="contact-form" id="contact-form">
        <label for="contact-name"><span data-i18n="contact.name">Your name</span> <span data-i18n="contact.optional">optional</span></label>
        <input id="contact-name" name="name" autocomplete="name" />

        <label for="contact-interest" data-i18n="contact.asking">I’m asking about</label>
        <select id="contact-interest" name="interest">
          <option value="a bottle" data-i18n="contact.optionBottle">A bottle</option>
          <option value="a new batch" data-i18n="contact.optionBatch">A new batch</option>
          <option value="gift presentation" data-i18n="contact.optionGift">Gift presentation</option>
          <option value="delivery" data-i18n="contact.optionDelivery">Delivery</option>
          <option value="something else" data-i18n="contact.optionOther">Something else</option>
        </select>

        <label for="contact-message" data-i18n="contact.message">Message</label>
        <textarea id="contact-message" name="message" rows="5" required placeholder="Which scent or question can we help with?" data-i18n-placeholder="contact.placeholder"></textarea>

        <button class="contact-submit" type="submit"><span data-i18n="contact.open">Open WhatsApp</span> <span aria-hidden="true">↗</span></button>
        <p class="contact-status" id="contact-status" role="status" aria-live="polite"></p>
      </form>
    </div>
  </main>

  <footer>
    <a class="brand-lockup" href={withBase("/")}>
      <img src={withBase("/brand/Logo.jpeg")} alt="" width="38" height="38" />
      <span class="wordmark">Heaven <i>&amp;</i> Nature</span>
    </a>
    <p data-i18n="footer.tagline">Fragrance, held in nature.</p>
    <nav aria-label="Footer links"><a href={withBase("/contact/")}><span data-i18n="footer.contact">Contact</span></a><a href={withBase("/testimonials/")}><span data-i18n="footer.notes">Customer notes</span></a><a href={whatsappUrl("Hi H&N Scents, I would like to ask about the collection.")} target="_blank" rel="noreferrer"><span data-i18n="footer.shop">Shop on WhatsApp</span></a><a href={withBase("/privacy/")}><span data-i18n="footer.privacy">Privacy</span></a><a href={withBase("/terms/")}><span data-i18n="footer.terms">Terms</span></a></nav>
    <p>© {new Date().getFullYear()} Heaven &amp; Nature</p>
  </footer>
</BaseLayout>

<script is:inline define:vars={{ whatsappBaseUrl }}>
  const form = document.querySelector<HTMLFormElement>("#contact-form");
  const status = document.querySelector<HTMLElement>("#contact-status");

  form?.addEventListener("submit", (event) => {
    event.preventDefault();
    const values = new FormData(form);
    const name = String(values.get("name") || "").trim();
    const interest = String(values.get("interest") || "a bottle");
    const message = String(values.get("message") || "").trim();
    const greeting = name ? `Hi H&N Scents, I’m ${name}.` : "Hi H&N Scents.";
    const text = `${greeting}\nI’m asking about ${interest}.\n\n${message}`;
    window.open(`${whatsappBaseUrl}?text=${encodeURIComponent(text)}`, "_blank", "noopener,noreferrer");
    if (status) status.textContent = "WhatsApp is opening with your message ready to send.";
  });
</script>
