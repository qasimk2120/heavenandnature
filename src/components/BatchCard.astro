---
import type { Batch } from "../data/batches";
import { whatsappUrl, withBase } from "../data/site";

interface Props {
  batch: Batch;
}

const { batch } = Astro.props;
---

<li class="catalogue-item" data-product-card data-product-slug={batch.slug}>
  <button class="catalogue-main" type="button" data-product-details={batch.slug} aria-label={`View details for ${batch.name}`}>
    <figure class="catalogue-image">
      {batch.image ? (
        <img src={withBase(batch.image)} alt={batch.imageAlt || batch.name} width="900" height="972" loading="lazy" decoding="async" />
      ) : (
        <div class="batch-placeholder" aria-hidden="true"><span>H&amp;N</span></div>
      )}
    </figure>
    <div class="catalogue-caption">
      <h3>{batch.name}</h3>
      {batch.collection && <p class="batch-collection">{batch.collection}</p>}
      <p class="batch-notes">{batch.shortDescription}</p>
      <p class="catalogue-size">{batch.size || "Details to be confirmed"}</p>
    </div>
  </button>
  <div class="catalogue-actions">
    <button class="catalogue-shop" type="button" data-add-to-cart={batch.slug}><span data-i18n="home.add">Add to cart</span> <span aria-hidden="true">＋</span></button>
    <a class="catalogue-ask" href={whatsappUrl(`Hi H&N Scents, I would like to ask about ${batch.name}.`)} target="_blank" rel="noreferrer"><span data-i18n="home.ask">Ask on WhatsApp</span> <span aria-hidden="true">↗</span></a>
  </div>
</li>
